---
import ThemeToggle from "./ThemeToggle.astro";

const user = Astro.locals.user;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-logo-link">
      <img
        src="/favicon.svg"
        alt="The Happy Feeling Prints Scriptorium Logo"
        class="site-logo-img"
      />
      <span class="site-wordmark">Happy Feeling Prints Scriptorium</span>
    </a>
    <nav class="site-nav">
      <a href="/blog">Gallery Blog</a>
      <a href="/shop">Shop Listings</a>
      <a href="/upcoming-events">Upcoming Events</a>
      {
        user ? (
          <a href="/admin/dashboard" class="site-nav__signin">
            Dashboard
          </a>
        ) : (
          <a href="/admin" class="site-nav__signin">
            Sign In
          </a>
        )
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
