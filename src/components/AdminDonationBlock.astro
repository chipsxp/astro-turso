---
/**
 * AdminDonationBlock.astro
 * Reusable PayPal donation block component for the site admin.
 */
const paypalEmail = process.env.PAYPAL_DONATION_EMAIL || "support@happyfeelingprints.com";
---

<div class="admin-donation-block">
  <div class="donation-header">
    <h3>Support the Scriptorium</h3>
    <p>If you enjoy our work, please consider supporting us!</p>
  </div>
  
  <form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_blank" class="paypal-form">
    <input type="hidden" name="cmd" value="_donations" />
    <input type="hidden" name="business" value={paypalEmail} />
    <input type="hidden" name="currency_code" value="USD" />
    <input type="hidden" name="item_name" value="Support The Happy Feeling Prints Scriptorium" />
    
    <button type="submit" class="paypal-btn">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
        <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106z"/>
      </svg>
      Donate via PayPal
    </button>
  </form>
</div>

<style>
  .admin-donation-block {
    background: var(--bg-card, #1e1e1e);
    border: 1px solid var(--border, #333);
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    margin: 1.5rem 0;
  }
  
  .donation-header h3 {
    margin: 0 0 0.5rem 0;
    font-family: var(--font-display, serif);
    color: var(--accent, #f2c85a);
    font-size: 1.5rem;
  }
  
  .donation-header p {
    margin: 0 0 1.5rem 0;
    color: var(--text-main, #e0e0e0);
    font-size: 1.05rem;
  }
  
  .paypal-form {
    display: flex;
    justify-content: center;
  }
  
  .paypal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #0070ba;
    color: #fff;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
  }
  
  .paypal-btn:hover {
    background: #005ea6;
    transform: translateY(-1px);
  }
  
  .paypal-btn:active {
    transform: translateY(1px);
  }
</style>
