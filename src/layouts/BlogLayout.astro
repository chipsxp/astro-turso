---
import SEOMeta from "../components/SEOMeta.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AdminDonationBlock from "../components/AdminDonationBlock.astro";
import { getSetting } from "../lib/settings";
import "../styles/global.css";

const donationPlacement = await getSetting("donation_placement") || "footer";

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
  fbAppId?: string;
}

const {
  title = "The Happy Feeling Scriptorium",
  description,
  canonicalUrl,
  ogType = "website",
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogImageType,
  publishedTime,
  modifiedTime,
  author,
  section,
  tags,
  fbAppId,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <!-- Favicon SVG -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        var t = localStorage.getItem("scriptorium_theme");
        document.documentElement.dataset.theme =
          t ||
          (window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark");
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEOMeta
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogImageType={ogImageType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      section={section}
      tags={tags}
      fbAppId={fbAppId}
    />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <Header />
    <div class="layout-wrapper" style="display: flex; flex-direction: column; min-height: 100vh;">
      <div class="layout-main" style="flex: 1; display: flex;">
        {donationPlacement === "sidebar" && (
          <aside class="site-sidebar" style="width: 300px; padding: 2rem 1rem; border-right: 1px solid var(--border);">
            <AdminDonationBlock />
          </aside>
        )}
        <main style="flex: 1; width: 100%;">
          <slot />
        </main>
      </div>
    </div>
    <Footer />
    
    <!-- Telemetry Tracker -->
    <script is:inline>
      document.addEventListener("click", function (e) {
        const target = e.target.closest("[data-track-type]");
        if (!target) return;

        const eventType = target.getAttribute("data-track-event") || "click";
        const targetType = target.getAttribute("data-track-type");
        const targetId = target.getAttribute("data-track-id") || null;

        const payload = JSON.stringify({
          event_type: eventType,
          target_type: targetType,
          target_id: targetId,
          page_path: window.location.pathname,
        });

        navigator.sendBeacon("/api/analytics/track", payload);
      });
    </script>
  </body>
</html>
