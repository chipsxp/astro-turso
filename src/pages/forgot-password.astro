---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — The Happy Feeling Prints Scriptorium</title>
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <style is:global>
      @import "../styles/pages/admin-login.css";

      .login-panel {
        overflow-y: auto;
      }
    </style>
  </head>
  <body>
    <div class="login-panels">
      <div class="hero-panel" aria-hidden="true">
        <p class="hero-issue">The Happy Feeling Prints Scriptorium — Vol. 1.3</p>
        <h1 class="hero-title">Forgot<br />Password</h1>
        <p class="hero-tagline">
          Enter your email to request a<br />password reset link
        </p>
      </div>

      <div class="login-panel">
        <span class="login-caption">Password Reset Request</span>

        <div class="login-form-wrap">
          <div id="error-msg" role="alert"></div>
          <div id="success-msg" style="display:none"></div>

          <form id="forgot-form" novalidate>
            <div class="form-group">
              <label class="form-label" for="email">Email address</label>
              <input
                class="form-input"
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
              />
            </div>

            <hr class="form-divider" />

            <button class="btn-enter" id="submit-btn" type="submit">
              Send Reset Link
            </button>
          </form>

          <p class="login-footer">
            Remembered your password? <a href="/admin">Sign in</a>
          </p>
        </div>
      </div>
    </div>

    <script>
      const form = document.getElementById("forgot-form") as HTMLFormElement;
      const errorEl = document.getElementById("error-msg") as HTMLDivElement;
      const successEl = document.getElementById("success-msg") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

      function showError(msg: string) {
        errorEl.textContent = msg;
        errorEl.style.display = "block";
        successEl.style.display = "none";
      }

      function clearError() {
        errorEl.style.display = "none";
        errorEl.textContent = "";
      }

      function showSuccess(msg: string) {
        successEl.textContent = msg;
        successEl.style.cssText =
          "display:block;padding:12px 14px;border:2px solid var(--success,#34c070);color:var(--success,#34c070);font-family:var(--font-mono);font-size:0.8rem;margin-bottom:16px;";
        form.style.display = "none";
        errorEl.style.display = "none";
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearError();

        const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();

        if (!email) {
          showError("Email is required.");
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";

        try {
          const res = await fetch("/api/auth/forgot-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });

          const data = await res.json();

          if (!res.ok) {
            showError(data.error ?? "Failed to send reset link. Please try again.");
            return;
          }

          showSuccess(data.message ?? "If that email exists, a reset link has been sent.");
        } catch {
          showError("Network error. Please try again.");
        } finally {
          submitBtn.disabled = false;
          if (submitBtn.textContent === "Sending…") {
            submitBtn.textContent = "Send Reset Link";
          }
        }
      });
    </script>
  </body>
</html>
