---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password — The Happy Feeling Prints Scriptorium</title>
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <style is:global>
      @import "../styles/pages/admin-login.css";

      .login-panel {
        overflow-y: auto;
      }
    </style>
  </head>
  <body>
    <div class="login-panels">
      <div class="hero-panel" aria-hidden="true">
        <p class="hero-issue">The Happy Feeling Prints Scriptorium — Vol. 1.3</p>
        <h1 class="hero-title">Reset<br />Password</h1>
        <p class="hero-tagline">
          Choose a new password for<br />your account
        </p>
      </div>

      <div class="login-panel">
        <span class="login-caption">Set New Password</span>

        <div class="login-form-wrap">
          <div id="error-msg" role="alert"></div>
          <div id="success-msg" style="display:none"></div>

          <form id="reset-form" novalidate>
            <div class="form-group">
              <label class="form-label" for="password">New Password</label>
              <input
                class="form-input"
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                placeholder="8 characters minimum"
                required
              />
            </div>

            <div class="form-group form-group--compact">
              <label class="form-label" for="confirm-password">Confirm Password</label>
              <input
                class="form-input"
                id="confirm-password"
                name="confirm-password"
                type="password"
                autocomplete="new-password"
                placeholder="••••••••"
                required
              />
            </div>

            <hr class="form-divider" />

            <button class="btn-enter" id="submit-btn" type="submit">
              Reset Password
            </button>
          </form>

          <p class="login-footer">
            <a href="/admin">Back to Sign in</a>
          </p>
        </div>
      </div>
    </div>

    <script>
      const form = document.getElementById("reset-form") as HTMLFormElement;
      const errorEl = document.getElementById("error-msg") as HTMLDivElement;
      const successEl = document.getElementById("success-msg") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

      function showError(msg: string) {
        errorEl.textContent = msg;
        errorEl.style.display = "block";
        successEl.style.display = "none";
      }

      function clearError() {
        errorEl.style.display = "none";
        errorEl.textContent = "";
      }

      function showSuccess(msg: string) {
        successEl.innerHTML = `${msg} <br/><br/> <a href="/admin" style="color:inherit;text-decoration:underline;">Click here to sign in</a>`;
        successEl.style.cssText =
          "display:block;padding:12px 14px;border:2px solid var(--success,#34c070);color:var(--success,#34c070);font-family:var(--font-mono);font-size:0.8rem;margin-bottom:16px;";
        form.style.display = "none";
        errorEl.style.display = "none";
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearError();

        const params = new URLSearchParams(window.location.search);
        const token = params.get("token");

        if (!token) {
          showError("Invalid or missing reset token. Please request a new link.");
          return;
        }

        const password = (form.elements.namedItem("password") as HTMLInputElement).value;
        const confirmPassword = (form.elements.namedItem("confirm-password") as HTMLInputElement).value;

        if (!password || !confirmPassword) {
          showError("All fields are required.");
          return;
        }

        if (password.length < 8) {
          showError("Password must be at least 8 characters.");
          return;
        }

        if (password !== confirmPassword) {
          showError("Passwords do not match.");
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Resetting…";

        try {
          const res = await fetch("/api/auth/reset-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, password }),
          });

          const data = await res.json();

          if (!res.ok) {
            showError(data.error ?? "Failed to reset password. Please try again.");
            return;
          }

          showSuccess(data.message ?? "Password reset successful.");
        } catch {
          showError("Network error. Please try again.");
        } finally {
          submitBtn.disabled = false;
          if (submitBtn.textContent === "Resetting…") {
            submitBtn.textContent = "Reset Password";
          }
        }
      });
    </script>
  </body>
</html>
