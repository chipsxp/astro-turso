---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getDonationConfig, getDonationPlacements } from "../../lib/settings";

const user = Astro.locals.user;
if (!user || user.role !== "admin") {
  return Astro.redirect("/admin");
}

const placements = await getDonationPlacements();
const config = await getDonationConfig();
const placementOptions = [
  ["dashboard_sidebar", "Dashboard Sidebar"],
  ["user_dashboard", "Top of Articles Dashboard"],
  ["article_index_top", "Top of Article Listings Page"],
  ["shop_index_top", "Top of Shop Item Posting Listings"],
  ["footer", "Footer"],
  ["homepage_grid", "Homepage Grid"],
  ["event_index_top", "Event Listing Page"],
];
---

<AdminLayout title="Site Settings">
  <div class="page-header">
    <div>
      <p class="page-header__eyebrow">Global Configuration</p>
      <h1 class="page-header__title">Site <em>Settings</em></h1>
    </div>
  </div>

  <div class="card" style="max-width: 600px; margin-top: 2rem;">
    <h2
      style="font-family: var(--font-display); color: var(--accent); margin-bottom: 1rem;"
    >
      Donation Block
    </h2>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
      Configure where the Admin Donation Block (PayPal) appears across the site.
    </p>

    <div
      id="settings-error"
      class="alert alert--error is-hidden"
      style="margin-bottom: 1rem;"
    >
    </div>
    <div
      id="settings-success"
      class="alert alert--success is-hidden"
      style="margin-bottom: 1rem;"
    >
      Settings saved successfully.
    </div>

    <form id="settings-form">
      <div class="form-group">
        <label class="form-label" for="donation_link">PayPal Donation Link</label>
        <input
          type="url"
          id="donation_link"
          class="form-input"
          style="width: 100%;"
          placeholder="https://www.paypal.com/donate/?hosted_button_id=..."
          value={config.link}
        />
      </div>
      <div class="form-group">
        <label class="form-label" for="donation_title">Block Title</label>
        <input
          type="text"
          id="donation_title"
          class="form-input"
          style="width: 100%;"
          maxlength="120"
          value={config.title}
        />
      </div>
      <div class="form-group">
        <label class="form-label" for="donation_text">Block Message</label>
        <textarea
          id="donation_text"
          class="form-input"
          style="width: 100%;"
          rows="2"
          maxlength="300">{config.text}</textarea
        >
      </div>
      <div class="form-group">
        <label class="form-label" for="donation_button_label"
          >Button Label</label
        >
        <input
          type="text"
          id="donation_button_label"
          class="form-input"
          style="width: 100%;"
          maxlength="60"
          value={config.button}
        />
      </div>

      <fieldset class="form-group" style="border: 0; padding: 0;">
        <legend class="form-label">Placement Locations</legend>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0 0 0.5rem;">
          Select one or more. Leave all unchecked to hide the block.
        </p>
        {
          placementOptions.map(([value, label]) => (
            <label style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.4rem;">
              <input
                type="checkbox"
                name="donation_placement"
                value={value}
                checked={placements.includes(value)}
              />
              {label}
            </label>
          ))
        }
      </fieldset>

      <div style="margin-top: 2rem;">
        <button type="submit" id="save-btn" class="btn btn-primary"
          >Save Settings</button
        >
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .is-hidden {
    display: none;
  }
  .form-group {
    margin-bottom: 1.5rem;
  }
  .form-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .form-input {
    padding: 0.5rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-main);
    border-radius: 4px;
  }
  .alert--success {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
    border: 1px solid #22c55e;
  }
</style>

<script>
  const form = document.getElementById("settings-form") as HTMLFormElement;
  const saveBtn = document.getElementById("save-btn") as HTMLButtonElement;
  const errorAlert = document.getElementById(
    "settings-error",
  ) as HTMLDivElement;
  const successAlert = document.getElementById(
    "settings-success",
  ) as HTMLDivElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorAlert.classList.add("is-hidden");
    successAlert.classList.add("is-hidden");
    saveBtn.disabled = true;
    saveBtn.textContent = "Saving...";

    const val = (id: string) =>
      (document.getElementById(id) as HTMLInputElement).value;
    const placement = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        'input[name="donation_placement"]:checked',
      ),
    )
      .map((c) => c.value)
      .join(",");

    try {
      const res = await fetch("/api/admin/settings", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          donation_placement: placement || "hidden",
          donation_link: val("donation_link"),
          donation_title: val("donation_title"),
          donation_text: val("donation_text"),
          donation_button_label: val("donation_button_label"),
        }),
      });

      if (!res.ok) {
        const d = await res.json().catch(() => ({}));
        throw new Error(d.error || "Failed to save settings");
      }

      successAlert.classList.remove("is-hidden");
    } catch (err: unknown) {
      errorAlert.textContent =
        err instanceof Error ? err.message : "Error saving settings";
      errorAlert.classList.remove("is-hidden");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Save Settings";
    }
  });
</script>
