---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../lib/db";

// Batch all global metrics, rankings, and analytics queries into a single round trip
const [
  countsRs,
  topArticlesRs,
  sharesByPlatformRs,
  topSharerRs,
  adsRs,
  statsRs,
] = await db.batch(
  [
    {
      sql: `SELECT 
              (SELECT COUNT(*) FROM users) AS total_users,
              (SELECT COUNT(*) FROM articles) AS total_articles,
              (SELECT COUNT(*) FROM events) AS total_events,
              (SELECT COUNT(*) FROM sales_postings) AS total_sales,
              (SELECT COUNT(*) FROM shares) AS total_shares`,
    },
    {
      sql: "SELECT id, title, slug, views FROM articles WHERE status = 'published' ORDER BY views DESC LIMIT 10",
    },
    {
      sql: "SELECT platform, COUNT(*) as count FROM shares GROUP BY platform ORDER BY count DESC",
    },
    {
      sql: `SELECT u.id, u.email, COUNT(s.id) as share_count 
            FROM shares s 
            JOIN users u ON s.user_id = u.id 
            WHERE datetime(s.shared_at, 'unixepoch') >= datetime('now', 'start of month') 
            GROUP BY u.id 
            ORDER BY share_count DESC 
            LIMIT 1`,
    },
    {
      sql: "SELECT id, business_name, slot_type, is_active FROM advertisements",
    },
    {
      sql: "SELECT target_id, COUNT(*) as click_count FROM analytics_events WHERE event_type = 'click' AND target_type = 'ad' GROUP BY target_id",
    },
  ],
  "read",
);

const countsRow = countsRs.rows[0] ?? {};
const totalUsers = Number(countsRow.total_users || 0);
const totalArticles = Number(countsRow.total_articles || 0);
const totalEvents = Number(countsRow.total_events || 0);
const totalSales = Number(countsRow.total_sales || 0);
const totalShares = Number(countsRow.total_shares || 0);

const topArticles = topArticlesRs.rows.map((r) => ({
  id: Number(r.id),
  title: String(r.title),
  slug: String(r.slug),
  views: Number(r.views || 0),
}));

const sharesByPlatform = sharesByPlatformRs.rows.map((r) => ({
  platform: String(r.platform),
  count: Number(r.count),
}));

const topSharerRow = topSharerRs.rows[0];
const topSharerNickname = topSharerRow
  ? String(topSharerRow.email).split("@")[0]
  : "None yet";
const topSharerCount = topSharerRow ? Number(topSharerRow.share_count) : 0;

const clickStats = new Map<number, number>();
for (const row of statsRs.rows) {
  clickStats.set(Number(row.target_id), Number(row.click_count));
}

const adPerformance = adsRs.rows
  .map((ad) => ({
    id: Number(ad.id),
    business_name: String(ad.business_name),
    slot_type: String(ad.slot_type),
    is_active: Number(ad.is_active),
    clicks: clickStats.get(Number(ad.id)) || 0,
  }))
  .sort((a, b) => b.clicks - a.clicks);
---

<AdminLayout title="Analytics & Reports">
  <div class="page-header">
    <div>
      <p class="page-header__eyebrow">Reports</p>
      <h1 class="page-header__title">Analytics Dashboard</h1>
    </div>
  </div>

  <div class="metrics-grid">
    <div class="card metric-card">
      <h3>Registered Users</h3>
      <div class="metric-value">{totalUsers}</div>
    </div>
    <div class="card metric-card">
      <h3>Published Articles</h3>
      <div class="metric-value">{totalArticles}</div>
    </div>
    <div class="card metric-card">
      <h3>Events Hosted</h3>
      <div class="metric-value">{totalEvents}</div>
    </div>
    <div class="card metric-card">
      <h3>Sales Items</h3>
      <div class="metric-value">{totalSales}</div>
    </div>
    <div
      class="card metric-card"
      style="border-color: var(--accent); background: var(--bg-card-alt, rgba(242, 200, 90, 0.05));"
    >
      <h3>Top Artist (Month)</h3>
      <div class="metric-value" style="font-size: 2rem;">
        {topSharerNickname}
      </div>
      <div
        style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;"
      >
        {topSharerCount} shares
      </div>
    </div>
  </div>

  <div class="dashboard-sections">
    <div class="card">
      <h2
        style="font-family: var(--font-display); color: var(--accent); margin-bottom: 1rem;"
      >
        Social Shares
      </h2>
      <div style="margin-bottom: 1.5rem;">
        <span style="font-size: 2.5rem; font-weight: 700;">{totalShares}</span>
        <span style="color: var(--text-muted); margin-left: 0.5rem;"
          >Total Shares</span
        >
      </div>

      {
        sharesByPlatform.length > 0 ? (
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
            {sharesByPlatform.map((share) => (
              <li style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: var(--surface-alt); border-radius: 4px;">
                <span style="text-transform: capitalize; font-weight: 600;">
                  {share.platform}
                </span>
                <span class="badge badge--published" style="font-size: 1rem;">
                  {share.count}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p style="color: var(--text-muted);">
            No social shares recorded yet.
          </p>
        )
      }
    </div>

    <div class="card">
      <h2
        style="font-family: var(--font-display); color: var(--accent); margin-bottom: 1rem;"
      >
        Top 10 Articles
      </h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Views</th>
            </tr>
          </thead>
          <tbody>
            {
              topArticles.length === 0 ? (
                <tr>
                  <td colspan="2" style="text-align: center; padding: 1rem;">
                    No articles published yet.
                  </td>
                </tr>
              ) : (
                topArticles.map((article) => (
                  <tr>
                    <td>
                      <a
                        href={`/blog/${article.slug}`}
                        target="_blank"
                        style="color: inherit; text-decoration: none; font-weight: 600;"
                      >
                        {article.title}
                      </a>
                    </td>
                    <td>
                      <strong>{article.views}</strong>
                    </td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2
        style="font-family: var(--font-display); color: var(--accent); margin-bottom: 1rem;"
      >
        Ad Performance
      </h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Business Name</th>
              <th>Status</th>
              <th>Slot</th>
              <th>Total Clicks</th>
            </tr>
          </thead>
          <tbody>
            {
              adPerformance.length === 0 ? (
                <tr>
                  <td colspan="4" style="text-align: center; padding: 1rem;">
                    No ads created yet.
                  </td>
                </tr>
              ) : (
                adPerformance.map((ad) => (
                  <tr>
                    <td>
                      <strong>{ad.business_name}</strong>
                    </td>
                    <td>
                      <span
                        class={`badge badge--${ad.is_active ? "published" : "draft"}`}
                      >
                        {ad.is_active ? "Active" : "Inactive"}
                      </span>
                    </td>
                    <td>
                      <span class="badge badge--draft">{ad.slot_type}</span>
                    </td>
                    <td>
                      <strong>{ad.clicks}</strong>
                    </td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<style is:global>
  @import "../../styles/pages/admin-dashboard.css";

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .metric-card {
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .metric-card h3 {
    margin: 0;
    font-size: 1rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .metric-card .metric-value {
    font-size: 3rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent);
    margin-top: 0.5rem;
  }

  .dashboard-sections {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .dashboard-sections {
      grid-template-columns: 1fr 2fr;
    }
  }
</style>
