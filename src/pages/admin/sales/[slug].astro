---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import SalesImageManager from "../../../components/admin/SalesImageManager";
import { db } from "../../../lib/db";
import { resolveCloudName } from "../../../lib/cloudinary";
import type {
  SalesPosting,
  SalesImage,
  SalesTestimonial,
  SalesReview,
} from "../../../lib/sales";

const { slug } = Astro.params;
const user = Astro.locals.user!;

const cloudName = resolveCloudName();

type PostingRow = SalesPosting & { author_email: string | null };
let posting: PostingRow | null = null;
let images: SalesImage[] = [];
let testimonials: SalesTestimonial[] = [];
let reviews: SalesReview[] = [];
let notFound = false;

try {
  const result = await db.execute<PostingRow>(
    `SELECT sp.*, u.email AS author_email
     FROM sales_postings sp
     LEFT JOIN users u ON u.id = sp.author_id
     WHERE sp.slug = ?`,
    [slug],
  );

  if (!result.rows.length) {
    notFound = true;
  } else {
    posting = result.rows[0];
    if (
      user.role !== "admin" &&
      Number(posting.author_id) !== Number(user.id)
    ) {
      notFound = true;
    }
  }

  if (!notFound) {
    const [imagesRes, testimonialsRes, reviewsRes] = await Promise.all([
      db.execute<SalesImage>(
        "SELECT * FROM sales_images WHERE posting_id = ? ORDER BY sort_order ASC",
        [Number(posting!.id)],
      ),
      db.execute<SalesTestimonial>(
        "SELECT * FROM sales_testimonials WHERE posting_id = ? ORDER BY sort_order ASC",
        [Number(posting!.id)],
      ),
      db.execute<SalesReview>(
        "SELECT * FROM sales_reviews WHERE posting_id = ? ORDER BY sort_order ASC",
        [Number(posting!.id)],
      ),
    ]);
    images = imagesRes.rows;
    testimonials = testimonialsRes.rows;
    reviews = reviewsRes.rows;
  }
} catch {
  notFound = true;
}

if (notFound || !posting) {
  return Astro.redirect("/admin/sales", 302);
}
---

<AdminLayout title={`Edit: ${posting.title}`}>
  <div class="page-header">
    <div>
      <p class="page-header__eyebrow">Shop</p>
      <h1 class="page-header__title">Edit <em>Sales Posting</em></h1>
    </div>
    <div class="flex" style="gap: 8px; align-items: center;">
      {
        posting.status === "published" && (
          <a href={`/shop/${slug}`} class="btn btn-ghost" target="_blank">
            View Live ↗
          </a>
        )
      }
      <a href="/admin/sales" class="btn btn-ghost">← Back to Postings</a>
    </div>
  </div>


  <form id="sales-form" novalidate data-slug={posting.slug}>
    <div class="editor-grid">
      <!-- ── Left column ─────────────────────────────────────────────── -->
      <div>
        <div class="card card--accent-top" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Content</p>

          <div class="form-group">
            <label class="form-label" for="title">Title *Required</label>
            <input
              class="form-input"
              id="title"
              name="title"
              type="text"
              value={posting.title}
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="slug">Slug</label>
            <input
              class="form-input"
              id="slug"
              name="slug"
              type="text"
              value={posting.slug}
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="status">Status</label>
            <select class="form-input" id="status" name="status">
              <option value="draft" selected={posting.status === "draft"}
                >Draft</option
              >
              <option
                value="published"
                selected={posting.status === "published"}>Published</option
              >
            </select>
          </div>

          <div class="form-group form-group--compact">
            <label class="form-label" id="body-label">Body</label>
            <div
              id="body-editor"
              class="form-textarea form-textarea--body quill-editor"
              style="min-height: 260px;"
            >
            </div>
            <input
              type="hidden"
              id="body-input"
              name="body"
              value={posting.body ?? ""}
            />
          </div>
        </div>

        <!-- Price & Promotion -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Price &amp; Promotion</p>

          <div class="form-group">
            <label class="form-label" for="price">Price (USD)</label>
            <input
              class="form-input"
              id="price"
              name="price"
              type="number"
              min="0"
              step="0.01"
              value={posting.price ?? ""}
              placeholder="0.00"
            />
            <span class="form-hint"
              >Display price — buyers can pay using the payment options below.</span
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="promo-label">Promo Label</label>
            <input
              class="form-input"
              id="promo-label"
              name="promo_label"
              type="text"
              value={posting.promo_label ?? ""}
            />
          </div>

          <div
            class="form-group"
            style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;"
          >
            <div>
              <label class="form-label" for="promo-discount">Discount %</label>
              <input
                class="form-input"
                id="promo-discount"
                name="promo_discount_pct"
                type="number"
                min="0"
                max="100"
                step="0.5"
                value={posting.promo_discount_pct ?? ""}
              />
            </div>
            <div>
              <label class="form-label">Sale Price Preview</label>
              <input
                class="form-input"
                id="sale-price-preview"
                type="text"
                readonly
              />
            </div>
          </div>

          <div
            class="form-group"
            style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;"
          >
            <div>
              <label class="form-label" for="promo-start">Promo Start</label>
              <input
                class="form-input"
                id="promo-start"
                name="promo_start"
                type="datetime-local"
                value={posting.promo_start
                  ? posting.promo_start.slice(0, 16)
                  : ""}
              />
            </div>
            <div>
              <label class="form-label" for="promo-end">Promo End</label>
              <input
                class="form-input"
                id="promo-end"
                name="promo_end"
                type="datetime-local"
                value={posting.promo_end ? posting.promo_end.slice(0, 16) : ""}
              />
            </div>
          </div>
        </div>

        <!-- Section 3: Payment Options -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Payment Options (Optional)</p>
          <p class="form-hint" style="margin-bottom: 1rem;">
            Add plain payment links here. These are different from PayPal button
            code, and you can offer more than one payment method.
          </p>
          <div class="form-group">
            <label class="form-label" for="paypal-link">PayPal Payment Link</label>
            <input
              class="form-input"
              id="paypal-link"
              name="paypal_link"
              type="url"
              inputmode="url"
              value={posting.paypal_link ?? ""}
              placeholder="https://paypal.me/yourname"
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="venmo-link">Venmo Payment Link</label>
            <input
              class="form-input"
              id="venmo-link"
              name="venmo_link"
              type="url"
              inputmode="url"
              value={posting.venmo_link ?? ""}
              placeholder="https://venmo.com/u/yourname"
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="cashapp-link">Cash App Payment Link</label>
            <input
              class="form-input"
              id="cashapp-link"
              name="cashapp_link"
              type="url"
              inputmode="url"
              value={posting.cashapp_link ?? ""}
              placeholder="https://cash.app/$yourcashtag"
            />
            <span class="form-hint">Use the full secure (https://) payment URL for each method.</span>
          </div>

          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label class="form-label" for="paypal-html"
              >PayPal Buy Button Code (Optional)</label
            >
            <textarea
              class="form-input"
              id="paypal-html"
              name="paypal_button_html"
              rows="4">{posting.paypal_button_html ?? ""}</textarea
            >
            <span class="form-hint">
              Get it from paypal.com → Pay &amp; Get Paid → Payment Buttons →
              Standard Buttons → Buy Now.
            </span>
          </div>

          <div class="form-group">
            <label class="form-label" for="qr-code-file"
              >QR Code (Venmo/CashApp/PayPal)</label
            >
            {
              posting.qr_code_url && (
                <div style="margin-bottom: 0.5rem;">
                  <img
                    src={posting.qr_code_url}
                    alt="QR Code"
                    style="max-height: 100px; border: 1px solid var(--border); border-radius: 4px;"
                  />
                </div>
              )
            }
            <input
              type="file"
              id="qr-code-file"
              accept="image/jpeg,image/png,image/webp,image/gif"
              class="form-input"
              style="padding: 0.5rem;"
            />
            <span class="form-hint"
              >Upload a payment QR code for this specific item. {
                posting.qr_code_url
                  ? "Uploading a new file will overwrite the existing one."
                  : ""
              }</span
            >
          </div>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="btn btn-primary"
          style="width: 100%;">Save Changes</button
        >
      </div>

      <!-- ── Right column ────────────────────────────────────────────── -->
      <div>
        <!-- Images with Cloudinary transforms -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Images</p>
          <SalesImageManager
            client:load
            postingSlug={posting.slug}
            cloudName={cloudName}
            initialImages={images.map((img) => ({
              id: Number(img.id),
              url: String(img.url ?? ""),
              public_id: String(img.public_id ?? ""),
              alt_text: String(img.alt_text ?? ""),
              transforms: String(img.transforms ?? "{}"),
              sort_order: Number(img.sort_order ?? 0),
            }))}
          />
        </div>

        <!-- Testimonials -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Testimonials</p>
          <div id="testimonials-list"></div>
          <button
            type="button"
            id="add-testimonial-btn"
            class="btn btn-ghost"
            style="margin-top: 0.5rem;">+ Add Testimonial</button
          >
          <input
            type="hidden"
            id="testimonials-json"
            name="testimonials_json"
            value={JSON.stringify(testimonials)}
          />
        </div>

        <!-- Reviews -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Reviews</p>
          <div id="reviews-list"></div>
          <button
            type="button"
            id="add-review-btn"
            class="btn btn-ghost"
            style="margin-top: 0.5rem;">+ Add Review</button
          >
          <input
            type="hidden"
            id="reviews-json"
            name="reviews_json"
            value={JSON.stringify(reviews)}
          />
        </div>

        <!-- Linked Article -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Linked Article (Optional)</p>
          <div class="form-group">
            <label class="form-label" for="linked-article">Article Slug</label>
            <input
              class="form-input"
              id="linked-article"
              name="linked_article_slug"
              type="text"
              value={posting.linked_article_slug ?? ""}
              placeholder="e.g. my-article-slug"
            />
          </div>
        </div>
      </div>
    </div>
  </form>
</AdminLayout>

<script>
  import "../../../scripts/admin/sales-edit.ts";
</script>

<style>
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }
  .sub-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.75rem;
    background: var(--color-surface-alt);
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }
  .btn--sm {
    align-self: flex-start;
  }
</style>
