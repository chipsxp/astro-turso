---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="New Sales Posting">
  <div class="page-header">
    <div>
      <p class="page-header__eyebrow">Shop</p>
      <h1 class="page-header__title">New <em>Sales Posting</em></h1>
    </div>
    <a href="/admin/sales" class="btn btn-ghost">← Back to Postings</a>
  </div>


  <form id="sales-form" novalidate>
    <div class="editor-grid">
      <!-- ── Left column ─────────────────────────────────────────────── -->
      <div>
        <!-- Section 1: Core Content -->
        <div class="card card--accent-top" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Content</p>

          <div class="form-group">
            <label class="form-label" for="title">Title *Required</label>
            <input
              class="form-input"
              id="title"
              name="title"
              type="text"
              placeholder="Posting title"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="slug">Slug</label>
            <input
              class="form-input"
              id="slug"
              name="slug"
              type="text"
              placeholder="auto-generated-from-title"
            />
            <span class="form-hint"
              >Leave blank to auto-generate from title</span
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="status">Status</label>
            <select class="form-input" id="status" name="status">
              <option value="draft" selected>Draft</option>
              <option value="published">Published</option>
            </select>
          </div>

          <div class="form-group form-group--compact">
            <label class="form-label" id="body-label">Body</label>
            <div
              id="body-editor"
              class="form-textarea form-textarea--body quill-editor"
              aria-labelledby="body-label"
              style="min-height: 260px;"
            >
            </div>
            <input type="hidden" id="body-input" name="body" />
          </div>
        </div>

        <!-- Section 2: Price & Promotion -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Price &amp; Promotion</p>

          <div class="form-group">
            <label class="form-label" for="price">Price (USD)</label>
            <input
              class="form-input"
              id="price"
              name="price"
              type="number"
              min="0"
              step="0.01"
              placeholder="0.00"
            />
            <span class="form-hint"
              >Display price — buyers can pay using the payment options below.</span
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="promo-label">Promo Label</label>
            <input
              class="form-input"
              id="promo-label"
              name="promo_label"
              type="text"
              placeholder="e.g. Spring Sale"
            />
          </div>

          <div
            class="form-group"
            style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;"
          >
            <div>
              <label class="form-label" for="promo-discount">Discount %</label>
              <input
                class="form-input"
                id="promo-discount"
                name="promo_discount_pct"
                type="number"
                min="0"
                max="100"
                step="0.5"
                placeholder="0"
              />
            </div>
            <div>
              <label class="form-label">Sale Price Preview</label>
              <input
                class="form-input"
                id="sale-price-preview"
                type="text"
                readonly
                placeholder="Enter price + discount %"
              />
            </div>
          </div>

          <div
            class="form-group"
            style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;"
          >
            <div>
              <label class="form-label" for="promo-start">Promo Start</label>
              <input
                class="form-input"
                id="promo-start"
                name="promo_start"
                type="datetime-local"
              />
            </div>
            <div>
              <label class="form-label" for="promo-end">Promo End</label>
              <input
                class="form-input"
                id="promo-end"
                name="promo_end"
                type="datetime-local"
              />
            </div>
          </div>
        </div>

        <!-- Section 3: Payment Options -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Payment Options (Optional)</p>
          <p class="form-hint" style="margin-bottom: 1rem;">
            Add plain payment links here. These are different from PayPal button
            code, and you can offer more than one payment method.
          </p>
          <div class="form-group">
            <label class="form-label" for="paypal-link">PayPal Payment Link</label>
            <input
              class="form-input"
              id="paypal-link"
              name="paypal_link"
              type="url"
              inputmode="url"
              placeholder="https://paypal.me/yourname"
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="venmo-link">Venmo Payment Link</label>
            <input
              class="form-input"
              id="venmo-link"
              name="venmo_link"
              type="url"
              inputmode="url"
              placeholder="https://venmo.com/u/yourname"
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="cashapp-link">Cash App Payment Link</label>
            <input
              class="form-input"
              id="cashapp-link"
              name="cashapp_link"
              type="url"
              inputmode="url"
              placeholder="https://cash.app/$yourcashtag"
            />
            <span class="form-hint">Use the full secure (https://) payment URL for each method.</span>
          </div>

          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label class="form-label" for="paypal-html"
              >PayPal Buy Button Code (Optional)</label
            >
            <textarea
              class="form-input"
              id="paypal-html"
              name="paypal_button_html"
              rows="4"
              placeholder='<div><style>...</style><form action="https://www.paypal.com/ncp/payment/...">'
            ></textarea>
            <span class="form-hint">
              Get it from paypal.com → Pay &amp; Get Paid → Payment Buttons →
              Standard Buttons → Buy Now.
            </span>
          </div>

          <div class="form-group">
            <label class="form-label" for="qr-code-file"
              >QR Code (Venmo/CashApp/PayPal)</label
            >
            <input
              type="file"
              id="qr-code-file"
              accept="image/jpeg,image/png,image/webp,image/gif"
              class="form-input"
              style="padding: 0.5rem;"
            />
            <span class="form-hint"
              >Upload a payment QR code for this specific item.</span
            >
          </div>
        </div>
      </div>

      <!-- ── Right column ────────────────────────────────────────────── -->
      <div>
        <!-- Section 4: Images (after save) -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Images</p>
          <div class="images-after-save-note">
            <p>
              Save this posting first, then add and configure images on the edit
              page.
            </p>
            <p>
              Up to 4 images per posting — with AI background removal, text
              overlay, and color options.
            </p>
          </div>
        </div>

        <!-- Section 5: Testimonials -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Testimonials</p>
          <div id="testimonials-list"></div>
          <button
            type="button"
            id="add-testimonial-btn"
            class="btn btn-ghost"
            style="margin-top: 0.5rem;">+ Add Testimonial</button
          >
          <input
            type="hidden"
            id="testimonials-json"
            name="testimonials_json"
            value="[]"
          />
        </div>

        <!-- Section 6: Reviews -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Reviews</p>
          <div id="reviews-list"></div>
          <button
            type="button"
            id="add-review-btn"
            class="btn btn-ghost"
            style="margin-top: 0.5rem;">+ Add Review</button
          >
          <input
            type="hidden"
            id="reviews-json"
            name="reviews_json"
            value="[]"
          />
        </div>

        <!-- Section 7: Linked Article -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <p class="panel-heading">Linked Article (Optional)</p>
          <div class="form-group">
            <label class="form-label" for="linked-article">Article Slug</label>
            <input
              class="form-input"
              id="linked-article"
              name="linked_article_slug"
              type="text"
              placeholder="e.g. my-article-slug"
            />
            <span class="form-hint"
              >Links to /articles/[slug] — shown as "Read more →" on the detail
              page</span
            >
          </div>
        </div>

        <!-- Submit -->
        <button
          type="submit"
          id="submit-btn"
          class="btn btn-primary"
          style="width: 100%;">Create Posting</button
        >
      </div>
    </div>
  </form>
</AdminLayout>

<script>
  import "../../../scripts/admin/sales-new.ts";
</script>

<style>
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }
  .images-after-save-note {
    color: var(--color-text-muted, #888);
    font-size: 0.875rem;
    line-height: 1.6;
    padding: 0.5rem 0;
  }
  .images-after-save-note p {
    margin: 0 0 0.4rem;
  }
  .sub-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.75rem;
    background: var(--color-surface-alt);
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }
  .btn--sm {
    align-self: flex-start;
  }
</style>
