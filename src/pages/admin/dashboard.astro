---
import AdminLayout from "../../layouts/AdminLayout.astro";
import PanelGallery from "../../components/admin/PanelGallery";
import {
  getUserGamificationStats,
  isTopSharerOfMonth,
} from "../../lib/monetization";
import { getDonationPlacements } from "../../lib/settings";
import AdminDonationBlock from "../../components/AdminDonationBlock.astro";

const userId = Astro.locals.user ? Number(Astro.locals.user.id) : 0;
const { totalShares } = await getUserGamificationStats(userId);
const topSharer = await isTopSharerOfMonth(userId);
const donationPlacement = await getDonationPlacements();
const isAdmin = Astro.locals.user?.role === "admin";

let gamificationRank = "Novice";
let badgeColor = "#777";
let badgeIcon = "🌟";

if (totalShares >= 101) {
  gamificationRank = "Platinum";
  badgeColor = "#e5e4e2";
  badgeIcon = "💎";
} else if (totalShares >= 51) {
  gamificationRank = "Gold";
  badgeColor = "#ffd700";
  badgeIcon = "🥇";
} else if (totalShares >= 11) {
  gamificationRank = "Silver";
  badgeColor = "#c0c0c0";
  badgeIcon = "🥈";
} else if (totalShares >= 1) {
  gamificationRank = "Bronze";
  badgeColor = "#cd7f32";
  badgeIcon = "🥉";
}
---

<AdminLayout title="Dashboard">
  <div class="page-header">
    <div>
      <p class="page-header__eyebrow">Content Archive</p>
      <h1 class="page-header__title">All <em>Articles</em></h1>
    </div>
    <a href="/admin/articles/new" class="btn btn-primary">+ New Article</a>
  </div>

  {donationPlacement.includes("user_dashboard") && <AdminDonationBlock />}

  <!-- Gamification Score Keeper -->
  <div
    class="card"
    style="margin-bottom: 2rem; border-color: var(--accent); position: relative; overflow: hidden;"
  >
    <div
      style="padding: 1.5rem; display: flex; align-items: center; gap: 2rem;"
    >
      <div
        style="font-size: 4rem; filter: drop-shadow(0 0 10px rgba(255,255,255,0.2));"
      >
        {badgeIcon}
      </div>
      <div>
        <p class="page-header__eyebrow" style={`color: ${badgeColor};`}>
          Author Rank
        </p>
        <h2
          style={`margin: 0 0 0.5rem 0; font-family: var(--font-display); color: ${badgeColor}; text-shadow: 0 2px 4px rgba(0,0,0,0.5);`}
        >
          {gamificationRank}
        </h2>
        <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">
          You have generated <strong>{totalShares}</strong> shares for your artwork
          blogs!
        </p>
        {
          gamificationRank === "Platinum" && (
            <div style="margin-top: 0.5rem; display: inline-block; background: var(--accent-transparent); color: var(--accent); padding: 2px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: bold;">
              👑 Top Tier Artist
            </div>
          )
        }
        {
          topSharer && (
            <div style="margin-top: 1rem; background: rgba(242, 200, 90, 0.15); border: 1px solid var(--accent); color: var(--accent); padding: 1rem; border-radius: 8px;">
              <strong style="font-size: 1.1rem; display: block; margin-bottom: 0.25rem;">
                🏆 Artist of the Month!
              </strong>
              You have the most social shares this month. Thank you for
              promoting the site! Enjoy your free advertisement block for the
              week.
            </div>
          )
        }
      </div>
    </div>
  </div>

  <!-- Filter bar -->
  <div class="filter-bar">
    <button class="btn btn-ghost filter-btn active" data-filter="all"
      >All</button
    >
    <button class="btn btn-ghost filter-btn" data-filter="published"
      >Published</button
    >
    <button class="btn btn-ghost filter-btn" data-filter="draft">Drafts</button>
    <span class="filter-bar__spacer"></span>
    <button
      id="cleanup-uploads-btn"
      type="button"
      class="btn btn-ghost filter-btn">Cleanup Uploads</button
    >
  </div>

  <!-- State: loading -->
  <div id="state-loading" class="state-caption">
    <span class="state-caption__label">Accessing Archives…</span>
  </div>

  <!-- State: error -->
  <div id="state-error" class="alert alert--error is-hidden"></div>

  <!-- State: empty -->
  <div id="state-empty" class="state-empty is-hidden">
    <span class="state-empty__impact">NOTHING HERE</span>
    <p class="state-empty__sub">
      The scriptorium is empty. No articles match this filter.
    </p>
  </div>

  <!-- ─── Homepage Panels ─── -->
  <div class="page-header" style="margin-top: 48px;">
    <div>
      <p class="page-header__eyebrow">Weekly Rotation</p>
      <h2 class="page-header__title">Homepage <em>Panels</em></h2>
    </div>
  </div>
  {
    isAdmin ? (
      <PanelGallery
        client:load
        cloudName={
          process.env.CLOUDINARY_CLOUD_NAME ??
          import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME
        }
      />
    ) : (
      <div class="alert alert--info" role="status">
        Homepage panels are not available for authors.
      </div>
    )
  }

  <!-- Article table panel -->
  <div id="state-table" class="card is-hidden">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Author</th>
            <th>Created</th>
            <th>Tags</th>
            <th class="table-actions-col">Actions</th>
          </tr>
        </thead>
        <tbody id="articles-tbody"></tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style is:global>
  @import "../../styles/pages/admin-dashboard.css";
  @import "../../styles/components/panel-gallery.css";
</style>

<script>
  import "../../scripts/admin/dashboard.ts";
</script>
