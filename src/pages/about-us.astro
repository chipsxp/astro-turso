---
import BlogLayout from "../layouts/BlogLayout.astro";

const siteUrl = import.meta.env.SITE_URL ?? "";
const canonicalUrl = `${siteUrl}/about-us`;
---

<BlogLayout
  title="About Us — The Happy Feeling Scriptorium"
  description="Learn more about The Happy Feeling Scriptorium and our creative publishing focus for artists, illustrators, and comic creators."
  canonicalUrl={canonicalUrl}
>
  <main class="page-wrap static-page">
    <h1>About Us</h1>
    <p>
      The Happy Feeling Scriptorium is a creative self-publishing space focused
      on practical insights, craft notes, and visual storytelling from artists,
      illustrators, and comic creators.
    </p>
    <p>
      We share process-driven experiences and customer appreciation notes in our
      articles that our artists wants to share with the world like consistent
      drawing, experimenting colors, growth across drawings, character design,
      and narrative art.
    </p>
    <p>
      The technology stack utilized to help present the artists' artwork to the
      world, to promote their events online, make their own sale pages and all
      profit stays with them from their hard-worked art is a completely free to
      use service. This is made possible by the Pixel Prime Studio. A software
      engineering family company directed and driven by Jimmy Burns, data
      engineer James Burns, together with over 25 years of experience in the
      computer hardware engineering industry, plus 15 years of software web,
      mobile, and AI application development and deployment experiences. Enjoy
      and keep it fun!
    </p>
    <div
      style="display: flex; flex-direction: column; align-items: center; margin-top: 3rem; margin-bottom: 2rem;"
    >
      <img
        src="/images/PPS-logo.jpg"
        alt="Pixel Prime Studio Logo"
        width="120"
        height="120"
        style="margin-bottom: 1.5rem;"
      />
      <img
        src="/images/PPS-logo-text.jpg"
        alt="Pixel Prime Studio"
        style="max-width: 100%; height: auto; max-height: 50px;"
      />
    </div>
  </main>
</BlogLayout>

<style>
  .static-page {
    max-width: 780px;
    padding-top: 56px;
    padding-bottom: 56px;
  }

  .static-page h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 18px;
    color: var(--text);
  }

  .static-page p {
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 14px;
  }
</style>
