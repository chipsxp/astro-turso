---
import BlogLayout from "../layouts/BlogLayout.astro";

const siteUrl = import.meta.env.SITE_URL ?? "";
const canonicalUrl = `${siteUrl}/privacy-policy`;
---

<BlogLayout
  title="Privacy Policy — The Happy Feeling Scriptorium"
  description="Privacy policy for The Happy Feeling Scriptorium."
  canonicalUrl={canonicalUrl}
>
  <main class="page-wrap static-page">
    <h1>Privacy Policy</h1>
    <p>
      At The Happy Feeling Prints Scriptorium, we are committed to respecting
      and protecting your privacy. We believe in transparency and want you to
      understand exactly how your data is handled when you visit and interact
      with our platform.
    </p>

    <h2>No Third-Party Tracking</h2>
    <p>
      We do not use any third-party statistical tracking, behavioral analysis
      tools, or advertising trackers to monitor your habits. Your browsing
      information is never sold to or collected by external data brokers. We do
      not use cross-site tracking scripts.
    </p>

    <h2>Local Data Collection and Usage</h2>
    <p>
      Any information collected on this site is securely processed and stored
      locally by Happy Feeling Prints and shared securely with our development
      company, Pixel Prime Studio. We only collect the minimal amount of data
      necessary to provide and improve our services to you.
    </p>
    <p>
      Specifically, the internal data we collect is utilized strictly for
      community features and platform functionality, including:
    </p>
    <ul>
      <li>Awarding contributor badges and event participation recognition.</li>
      <li>
        Determining the "Artist Share of the Month" and community highlights.
      </li>
      <li>
        Aggregating internal ad clicks to support the platform and our artists
        directly.
      </li>
      <li>
        Securing your session via strict, server-side authentication without
        third-party identity providers.
      </li>
    </ul>

    <h2>Data Storage and Infrastructure</h2>
    <p>
      Our platform is built with a privacy-first architecture. We utilize secure
      edge databases for our application data and dedicated media storage solely
      for artist uploads. User credentials and sessions are strictly managed
      through secure, HttpOnly cookies.
    </p>

    <h2>Contact and Support</h2>
    <p>
      If you contact us directly through our Contact Us page or via email, any
      information you provide is used exclusively for communication and support
      purposes and is never shared outside of our organization.
    </p>

    <p>
      Policy updates may be posted on this page as the site evolves and new
      community features are added.
    </p>

    <div
      style="display: flex; flex-direction: column; align-items: center; margin-top: 3rem; margin-bottom: 1rem;"
    >
      <img
        src="/images/PPS-logo.jpg"
        alt="Pixel Prime Studio Logo"
        width="120"
        height="120"
        style="margin-bottom: 1.5rem;"
      />
      <img
        src="/images/PPS-logo-text.jpg"
        alt="Pixel Prime Studio"
        style="max-width: 100%; height: auto; max-height: 50px;"
      />
    </div>
  </main>
</BlogLayout>

<style>
  .static-page {
    max-width: 780px;
    padding-top: 56px;
    padding-bottom: 56px;
  }

  .static-page h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 18px;
    color: var(--text);
  }

  .static-page h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    margin-top: 36px;
    margin-bottom: 14px;
    color: var(--text);
  }

  .static-page p {
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 14px;
  }

  .static-page ul {
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 24px;
    padding-left: 20px;
  }

  .static-page li {
    margin-bottom: 8px;
  }
</style>
